# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables & secrets
.env

# Clipper Cache & Storage directories
static/cache/*
!static/cache/.gitkeep
static/exports/*
!static/exports/.gitkeep
static/uploads/*
!static/uploads/.gitkeep

# Temporary files
*.mp4
*.mp3
*.zip
*.log

# OS generated files
.DS_Store
Thumbs.db
